# Atendimento.Center Flow Engine (Typebot fork)

# URLs
NEXTAUTH_URL=https://flow.atendimento.center
NEXT_PUBLIC_VIEWER_URL=https://bot.atendimento.center
NEXT_PUBLIC_BUILDER_ORIGIN=https://flow.atendimento.center

# Persistence
TYPEBOT_DB_PASSWORD=
DATABASE_URL=postgresql://postgres:${TYPEBOT_DB_PASSWORD}@typebot-db:5432/typebot
REDIS_URL=redis://typebot-redis:6379

# Security
# Exactly 32 characters. Generate independently for this deployment.
ENCRYPTION_SECRET=
# Keep signup enabled only until the first internal administrator is created.
DISABLE_SIGNUP=false
DEFAULT_WORKSPACE_PLAN=UNLIMITED
TYPEBOT_DEBUG=false

# Optional: the internal administrator e-mail receives UNLIMITED privileges.
ADMIN_EMAIL=

# Optional authentication providers.
# GitHub OAuth callback:
# https://flow.atendimento.center/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional SMTP authentication / notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
NEXT_PUBLIC_SMTP_FROM='Atendimento.Center Flow <no-reply@atendimento.center>'

# Optional storage, recommended before enabling file uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=typebot
S3_ENDPOINT=
S3_REGION=
S3_SSL=true
